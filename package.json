{
  "name": "streamdeck-lastfm",
  "version": "0.0.0-development",
  "description": "A Last.fm integration for Elgato Stream Deck",
  "private": true,
  "author": "Verringer",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && webpack --mode=development",
    "build-prod": "npm run clean && webpack --mode=production",
    "ci": "npm run type-check && npm run lint && npm run format:check && npm run build-prod",
    "clean": "rimraf dist",
    "format": "prettier --write 'src/**/*.ts' 'build/**/*.{ts,cjs}' webpack.config.cjs eslint.config.mjs package.json .babelrc .prettierrc.json .github/workflows/ci.yml .github/workflows/release.yml",
    "format:check": "prettier --check 'src/**/*.ts' 'build/**/*.{ts,cjs}' webpack.config.cjs eslint.config.mjs package.json .babelrc .prettierrc.json .github/workflows/ci.yml .github/workflows/release.yml",
    "lint": "eslint 'src/**/*.ts' 'build/**/*.ts' 'build/**/*.cjs' webpack.config.cjs",
    "package-plugin": "node build/scripts/package-plugin.cjs",
    "set-plugin-version": "node build/scripts/set-plugin-version.cjs",
    "type-check": "tsc --noEmit",
    "watch": "webpack watch --mode=development"
  },
  "dependencies": {
    "@rweich/streamdeck-formbuilder": "^2.1.3",
    "@rweich/streamdeck-ts": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "fflate": "^0.8.2",
    "rimraf": "^6.1.3",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "typescript-eslint": "^8.67.0",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "repository": "verringer/streamdeck-lastfm",
  "bugs": "https://github.com/Verringer/streamdeck-lastfm/issues",
  "overrides": {
    "@rweich/streamdeck-ts": {
      "ajv": "^8.20.0",
      "ws": "^8.21.0"
    },
    "isomorphic-ws": {
      "ws": "^8.21.0"
    }
  }
}
